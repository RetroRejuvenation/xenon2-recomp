{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build-${presetName}",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "X2_REQUIRE_SDL3": "ON" }
    },
    {
      "name": "ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja"
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0" }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64 (installed SDL3, e.g. Homebrew)",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64" }
    },
    {
      "name": "macos-x86_64",
      "displayName": "macOS x86_64 (pinned SDL3 built from source)",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "x86_64", "X2_FETCH_SDL3": "ON" }
    },
    {
      "name": "macos-universal",
      "displayName": "macOS universal arm64 + x86_64 (pinned SDL3 built from source)",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64", "X2_FETCH_SDL3": "ON" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux Clang",
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (Visual Studio 2022, x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": null, "X2_FETCH_SDL3": "ON" }
    },
    {
      "name": "windows-clangcl",
      "displayName": "Windows clang-cl (Visual Studio 2022 ClangCL toolset, x64)",
      "inherits": "windows-msvc",
      "toolset": "ClangCL"
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows MinGW-w64 GCC (MSYS2 UCRT64)",
      "inherits": "ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++", "X2_FETCH_SDL3": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x86_64", "configurePreset": "macos-x86_64" },
    { "name": "macos-universal", "configurePreset": "macos-universal" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-clangcl", "configurePreset": "windows-clangcl", "configuration": "Release" },
    { "name": "windows-mingw", "configurePreset": "windows-mingw" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" },
      "environment": { "SDL_VIDEO_DRIVER": "dummy", "SDL_AUDIO_DRIVER": "dummy" }
    },
    { "name": "macos-arm64", "inherits": "base", "configurePreset": "macos-arm64" },
    { "name": "macos-x86_64", "inherits": "base", "configurePreset": "macos-x86_64" },
    { "name": "macos-universal", "inherits": "base", "configurePreset": "macos-universal" },
    { "name": "linux-gcc", "inherits": "base", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "inherits": "base", "configurePreset": "linux-clang" },
    { "name": "windows-msvc", "inherits": "base", "configurePreset": "windows-msvc", "configuration": "Release" },
    { "name": "windows-clangcl", "inherits": "base", "configurePreset": "windows-clangcl", "configuration": "Release" },
    { "name": "windows-mingw", "inherits": "base", "configurePreset": "windows-mingw" }
  ]
}
