; x2recomp reference machine: A500, 68000, OCS, 512K chip, PAL, Kickstart 1.3.
; run.sh replaces @KICK@, @DF0@ and @DF1@.
config_description=x2recomp reference A500
config_hardware=true
config_host=true
config_version=7.0.8
use_gui=no
use_debugger=false
kickstart_rom_file=@KICK@
kickstart_ext_rom_file=
floppy0=@DF0@
floppy0type=0
floppy1=@DF1@
floppy1type=0
nr_floppies=2
floppy_speed=100
floppy_volume=0
sound_output=exact
sound_channels=stereo
sound_stereo_separation=10
sound_stereo_mixing_delay=0
sound_frequency=48000
sound_interpol=none
sound_filter=emulated
sound_filter_type=standard
sound_auto=false
joyport0=mouse
joyport1=kbd1
chipset=ocs
chipset_compatible=A500
ntsc=false
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=true
cpu_memory_cycle_exact=true
blitter_cycle_exact=true
cpu_24bit_addressing=true
chipmem_size=1
bogomem_size=0
fastmem_size=0
z3mem_size=0
immediate_blits=false
multithreaded_drawing=false
gfx_framerate=1
gfx_resolution=lores
gfx_lores_mode=normal
gfx_linemode=none
gfx_vsync=false
gfx_center_horizontal=none
gfx_center_vertical=none
