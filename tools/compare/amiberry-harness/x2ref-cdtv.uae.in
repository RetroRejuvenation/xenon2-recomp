; x2recomp reference machine for the CDTV release: Commodore CDTV (OCS chip set with an ECS Agnus, 68000, 1 MB chip RAM, PAL),
; Kickstart 1.3 + a CDTV extended ROM (v1.0, v2.30 or v2.35; user-supplied ROMs), the game's CD image in the CD drive.
; fastmem_size=1 (512 KB fast RAM) is REQUIRED: the CDTV program needs 811,612 bytes of chip RAM in two hunks and does
; not start if the operating system's own allocations sit in chip RAM (the machine idles after the CDTV logo).
; chipset=ecs_agnus is REQUIRED too: with an OCS Agnus the DMA pointers wrap at 512 KB and the game's display buffers (in the
; second hunk, above $80000) are fetched from the wrong place (level 1 shows dotted vertical streaks on black).
; run-cdtv.sh replaces @KICK@, @EXT@ and @CD@.
config_description=x2recomp reference CDTV
config_hardware=true
config_host=true
config_version=7.0.8
use_gui=no
use_debugger=false
kickstart_rom_file=@KICK@
kickstart_ext_rom_file=@EXT@
cdimage0=@CD@
chipset_compatible=CDTV
cdtvcd=true
cdtvram=true
sound_output=exact
sound_channels=stereo
sound_frequency=48000
sound_interpol=none
sound_filter=emulated
sound_auto=false
joyport0=mouse
joyport1=kbd1
chipset=ecs_agnus
ntsc=false
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=true
cpu_memory_cycle_exact=true
blitter_cycle_exact=true
cpu_24bit_addressing=true
chipmem_size=2
bogomem_size=0
fastmem_size=1
z3mem_size=0
immediate_blits=false
multithreaded_drawing=false
gfx_framerate=1
gfx_resolution=lores
gfx_lores_mode=normal
gfx_linemode=none
gfx_vsync=false
gfx_center_horizontal=none
gfx_center_vertical=none
