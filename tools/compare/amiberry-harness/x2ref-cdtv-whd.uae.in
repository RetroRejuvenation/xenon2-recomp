; x2recomp reference machine for the CDTV release run under the WHDLoad CDTV slave (Xenon2CDTV.Slave, v1.6):
; A500+-class, ECS Agnus with 1 MB chip RAM (the slave needs 1.0 MB chip and 0.5 MB other memory), 1 MB fast RAM,
; Kickstart 2.04 (user-supplied ROM: the current WHDLoad program does not load under 1.3), PAL. The install lives in a
; host directory mounted as DH0: (booted via the directory file system); its S/startup-sequence runs WHDLoad. run-cdtv-whd.sh replaces @KICK@ and @DH0@.
config_description=x2recomp reference CDTV via WHDLoad
config_hardware=true
config_host=true
config_version=7.0.8
use_gui=no
use_debugger=false
kickstart_rom_file=@KICK@
kickstart_ext_rom_file=
filesystem2=rw,DH0:dh0:@DH0@,0
nr_floppies=0
sound_output=exact
sound_channels=stereo
sound_stereo_separation=10
sound_stereo_mixing_delay=0
sound_frequency=48000
sound_interpol=none
sound_filter=emulated
sound_filter_type=standard
sound_auto=false
joyport0=mouse
joyport1=kbd1
chipset=ecs_agnus
chipset_compatible=A500+
ntsc=false
cpu_type=68000
cpu_model=68000
cpu_speed=real
cpu_compatible=true
cpu_cycle_exact=true
cpu_memory_cycle_exact=true
blitter_cycle_exact=true
cpu_24bit_addressing=true
chipmem_size=2
bogomem_size=0
fastmem_size=1
z3mem_size=0
immediate_blits=false
multithreaded_drawing=false
gfx_framerate=1
gfx_resolution=lores
gfx_lores_mode=normal
gfx_linemode=none
gfx_vsync=false
gfx_center_horizontal=none
gfx_center_vertical=none
