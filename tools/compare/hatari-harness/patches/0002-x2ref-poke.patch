+/* Events after an "ANCHOR <level>" line are relative: "+<delta> ..." lines are scheduled <delta> VBLs after the anchor, the first VBL at which
+   the scroll position $CD0 leaves $1200 once level <level> ($E04) is up. Hatari's loads are slower than the game's own timing and vary
+   from run to run, so the inputs are timed from the game's event and not from the emulator's VBL count. */
+static Event *rel;
+static int nrel, ngroups, cur_group, wait_group = 1, anchor_stage;
+static int group_level[16];
+static unsigned seqn;
+static int force_shot, force_ram;
