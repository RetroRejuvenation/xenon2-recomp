+static void push_event(Event e)
+{
+	Event **arr = cur_group ? &rel : &events;
+	int *n = cur_group ? &nrel : &nevents;
+	Event *ne = realloc(*arr, (*n + 1) * sizeof **arr);
+	if (!ne) return;
+	*arr = ne;
+	e.seq = seqn++;
+	e.group = cur_group;
+	(*arr)[(*n)++] = e;
+}
+
+static int ev_cmp(const void *x, const void *y)
+{
+	const Event *a = x, *b = y;
+	if (a->vbl != b->vbl) return a->vbl < b->vbl ? -1 : 1;
+	return a->seq < b->seq ? -1 : a->seq > b->seq;
+}
