diff --color --color=never -ruN a/src/x2ref.c b/src/x2ref.c
--- a/src/x2ref.c	1970-01-01 01:00:00
+++ b/src/x2ref.c	2026-10-31 19:34:45
@@ -0,0 +1,165 @@
+/*
+  x2recomp reference harness for Hatari (SPDX-License-Identifier: GPL-2.0-or-later, as Hatari).
+  Everything is driven by environment variables and is inert when X2REF_DIR is unset:
+    X2REF_DIR    output directory (frames.log, PNGs, WAV, RAM dumps)
+    X2REF_SHOTS  VBLs to save as PNG, e.g. "100,200-260,1000-2000/50" (/n = every n-th)
+    X2REF_RAM    VBLs at which to dump ST RAM, same syntax
+    X2REF_INPUT  script file: lines "<vbl> <event> <0|1>"; events JOY0_UP/DOWN/LEFT/RIGHT/FIRE and the same for
+                 JOY1_ (needs --joy0/--joy1 keys), or KEY<hex ST scancode>. '#' starts a comment.
+    X2REF_WATCH  ST RAM word addresses (hex, comma separated) logged every VBL
+    X2REF_QUIT   VBL at which to quit
+    X2REF_WAV    1 = record the YM/sound output into ym.wav from the first VBL
+  VBL numbers count the Main_WaitOnVbl calls from emulator start (the first VBL is 1). frames.log lines:
+  "<vbl> pc=<hex> sr=<hex> vbase=<hex> [<addr>=<word>...]".
+*/
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "main.h"
+#include "ikbd.h"
+#include "joy.h"
+#include "m68000.h"
+#include "sound.h"
+#include "screenSnapShot.h"
+#include "stMemory.h"
+#include "video.h"
+#include "x2ref.h"
+
+typedef struct { uint32_t from, to, step; } Range;
+typedef struct { uint32_t vbl; int kind; int a; int b; } Event;   /* kind 0 joy(port a, bit b, state), 1 key */
+
+static int inited, active;
+static char dir[1024];
+static Range shots[64], rams[64];
+static int nshots, nrams;
+static Event *events;
+static int nevents, evpos;
+static uint32_t watch[32];
+static int nwatch;
+static uint32_t quit_vbl;
+static uint32_t vbl;
+static FILE *flog;
+
+static int parse_set(const char *s, Range *r, int max)
+{
+	int n = 0;
+	while (s && *s && n < max) {
+		char *e;
+		uint32_t a = strtoul(s, &e, 10), b = a, st = 1;
+		if (*e == '-') b = strtoul(e + 1, &e, 10);
+		if (*e == '/') st = strtoul(e + 1, &e, 10);
+		r[n].from = a; r[n].to = b; r[n].step = st ? st : 1; n++;
+		s = (*e == ',') ? e + 1 : e;
+		if (*e != ',') break;
+	}
+	return n;
+}
+
+static int in_set(const Range *r, int n, uint32_t v)
+{
+	for (int i = 0; i < n; i++)
+		if (v >= r[i].from && v <= r[i].to && ((v - r[i].from) % r[i].step) == 0) return 1;
+	return 0;
+}
+
+static void load_input(const char *path)
+{
+	FILE *f = fopen(path, "r");
+	char line[256];
+	if (!f) { fprintf(stderr, "X2REF: cannot open %s\n", path); return; }
+	while (fgets(line, sizeof line, f)) {
+		char ev[64]; unsigned n; int st;
+		char *h = strchr(line, '#'); if (h) *h = 0;
+		if (sscanf(line, "%u %63s %d", &n, ev, &st) != 3) continue;
+		Event e = { n, 0, 0, 0 };
+		if (!strncmp(ev, "JOY0_", 5) || !strncmp(ev, "JOY1_", 5)) {
+			e.a = ev[3] - '0';
+			const char *d = ev + 5;
+			e.b = !strcmp(d, "UP") ? ATARIJOY_BITMASK_UP : !strcmp(d, "DOWN") ? ATARIJOY_BITMASK_DOWN :
+			      !strcmp(d, "LEFT") ? ATARIJOY_BITMASK_LEFT : !strcmp(d, "RIGHT") ? ATARIJOY_BITMASK_RIGHT :
+			      !strcmp(d, "FIRE") ? ATARIJOY_BITMASK_FIRE : 0;
+			if (!e.b) continue;
+		} else if (!strncmp(ev, "KEY", 3)) {
+			e.kind = 1; e.a = (int)strtoul(ev + 3, NULL, 16); e.b = 0;
+		} else continue;
+		e.a |= 0; /* port or scancode */
+		Event *ne = realloc(events, (nevents + 1) * sizeof *events);
+		if (!ne) break;
+		events = ne;
+		/* keep the state in the high bits of b */
+		e.b |= st ? 0x10000 : 0;
+		events[nevents++] = e;
+	}
+	fclose(f);
+	/* stable sort by vbl (script lines are normally in order) */
+	for (int i = 1; i < nevents; i++) {
+		Event t = events[i]; int j = i - 1;
+		while (j >= 0 && events[j].vbl > t.vbl) { events[j + 1] = events[j]; j--; }
+		events[j + 1] = t;
+	}
+}
+
+static void init(void)
+{
+	const char *d = getenv("X2REF_DIR");
+	inited = 1;
+	if (!d || !*d) return;
+	active = 1;
+	snprintf(dir, sizeof dir, "%s", d);
+	nshots = parse_set(getenv("X2REF_SHOTS"), shots, 64);
+	nrams = parse_set(getenv("X2REF_RAM"), rams, 64);
+	if (getenv("X2REF_QUIT")) quit_vbl = strtoul(getenv("X2REF_QUIT"), NULL, 10);
+	if (getenv("X2REF_INPUT")) load_input(getenv("X2REF_INPUT"));
+	if (getenv("X2REF_WATCH")) {
+		const char *s = getenv("X2REF_WATCH");
+		while (*s && nwatch < 32) {
+			char *e; watch[nwatch++] = strtoul(s, &e, 16);
+			if (*e != ',') break;
+			s = e + 1;
+		}
+	}
+	char p[1100];
+	snprintf(p, sizeof p, "%s/frames.log", dir);
+	flog = fopen(p, "w");
+	if (getenv("X2REF_WAV") && getenv("X2REF_WAV")[0] == '1') {
+		snprintf(p, sizeof p, "%s/ym.wav", dir);
+		Sound_BeginRecording(p);
+	}
+}
+
+void X2ref_VBL(void)
+{
+	if (!inited) init();
+	if (!active) return;
+	vbl++;
+	while (evpos < nevents && events[evpos].vbl <= vbl) {
+		Event *e = &events[evpos++];
+		int st = (e->b & 0x10000) != 0;
+		int bit = e->b & 0xffff;
+		if (e->kind == 0) Joy_X2refSet(e->a, bit, st);
+		else IKBD_PressSTKey((uint8_t)e->a, st != 0);
+		fprintf(stderr, "X2REF: vbl %u event kind %d a %d b %x state %d\n", vbl, e->kind, e->a, bit, st);
+	}
+	if (flog) {
+		fprintf(flog, "%u pc=%06x sr=%04x vbase=%06x", vbl, (unsigned)M68000_GetPC(), (unsigned)M68000_GetSR(), (unsigned)Video_GetScreenBaseAddr());
+		for (int i = 0; i < nwatch; i++) fprintf(flog, " %x=%04x", watch[i], STMemory_ReadWord(watch[i]));
+		fprintf(flog, "\n");
+		fflush(flog);
+	}
+	if (in_set(shots, nshots, vbl)) {
+		char p[1100];
+		snprintf(p, sizeof p, "%s/shot_%06u.png", dir, vbl);
+		ScreenSnapShot_SaveToFile(p);
+	}
+	if (in_set(rams, nrams, vbl)) {
+		char p[1100];
+		snprintf(p, sizeof p, "%s/ram_%06u.bin", dir, vbl);
+		FILE *f = fopen(p, "wb");
+		if (f) { fwrite(STRam, 1, STRamEnd, f); fclose(f); }
+	}
+	if (quit_vbl && vbl >= quit_vbl) {
+		Sound_EndRecording();
+		if (flog) { fclose(flog); flog = NULL; }
+		exit(0);
+	}
+}
