 /**
+ * x2recomp reference harness: set or clear one direction/fire bit of the keyboard-emulated joystick on a port.
+ */
+void Joy_X2refSet(int port, int bit, int state)
+{
+	if (port < 0 || port >= JOYSTICK_COUNT)
+		return;
+	if (state)
+	{
+		if (bit == ATARIJOY_BITMASK_UP)    nJoyKeyEmu[port] &= ~ATARIJOY_BITMASK_DOWN;
+		if (bit == ATARIJOY_BITMASK_DOWN)  nJoyKeyEmu[port] &= ~ATARIJOY_BITMASK_UP;
+		if (bit == ATARIJOY_BITMASK_LEFT)  nJoyKeyEmu[port] &= ~ATARIJOY_BITMASK_RIGHT;
+		if (bit == ATARIJOY_BITMASK_RIGHT) nJoyKeyEmu[port] &= ~ATARIJOY_BITMASK_LEFT;
+		nJoyKeyEmu[port] |= bit;
+	}
+	else
+		nJoyKeyEmu[port] &= ~bit;
+}
