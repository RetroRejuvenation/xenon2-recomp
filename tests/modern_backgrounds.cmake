# Backgrounds, round stars and hit flashes on the real game (asset packs v2, WS2b; docs/re-notes/asset-packs-backgrounds.md).
# Exits 77 (CTest "Skipped") without the user's assets. Everything it writes stays in OUT (the dump is the user's own game
# graphics: never commit it).
# Usage: cmake -DX2RECOMP=<exe> -DASSETS=<dir> -DREPLAY=<script> -DOUT=<dir> [-DRECOMP=1] [-DFRAMES=.. -DFROM=.. -DTO=..] -P modern_backgrounds.cmake
#  1. --dump-assets writes far_full/levelN.png (the level's far layer, the ring unrolled), the hit flashes and a version 2 manifest.
#  2. A pack of that picture alone (a `backgrounds` section) gives exactly the interpolated pictures of the plain replay: the
#     ring binding and the unrolling agree. One declared with another ring height is ignored.
#  3. `stars` with the pixel shape change nothing; the round shape does, deterministically (and the same under the translated
#     executor and --interp-only).
#  4. The dump as a pack reproduces the pictures with the explicit hit flashes; without them the flashes are derived from the
#     replaced bobs and only the flash pictures change.
if(NOT EXISTS "${ASSETS}/game_0400.bin" OR (NOT EXISTS "${ASSETS}/disc2.bin" AND NOT EXISTS "${ASSETS}/cd0"))
  message("SKIPPED: no game data in ${ASSETS}")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED FRAMES)
  set(FRAMES 1460)
endif()
if(NOT DEFINED FROM)
  set(FROM 1150)
endif()
if(NOT DEFINED TO)
  set(TO 1450)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(base "${X2RECOMP}" --headless --assets "${ASSETS}" --no-reglog --report-every 0 --input-script "${REPLAY}" --frames ${FRAMES})

function(run out_var)
  execute_process(COMMAND ${base} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp ${ARGN} exited with ${rc}: ${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# The presented pictures of the window, as a list of "presenthash ..." entries.
function(pictures var)
  run(out --modern interp,scale=${SCALE} ${ARGN} --modern-out ${FROM}-${TO}:-)
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" hashes "${out}")
  set(${var} "${hashes}" PARENT_SCOPE)
  set(${var}_out "${out}" PARENT_SCOPE)
endfunction()

function(write_pack dir members)
  file(MAKE_DIRECTORY "${dir}")
  file(WRITE "${dir}/manifest.json" "{\"format\": \"x2-asset-pack\", \"version\": 2, \"name\": \"test\"${members}}\n")
endfunction()

function(count_diff a b out_var)
  list(LENGTH a n)
  set(d 0)
  set(i 0)
  while(i LESS n)
    list(GET a ${i} x)
    list(GET b ${i} y)
    if(NOT x STREQUAL y)
      math(EXPR d "${d} + 1")
    endif()
    math(EXPR i "${i} + 1")
  endwhile()
  set(${out_var} ${d} PARENT_SCOPE)
endfunction()

# 1. The dump.
run(out --dump-assets "${OUT}/dump")
if(NOT out MATCHES "dump-assets: ([0-9]+) sprites, ([0-9]+) tiles, ([0-9]+) far lines, ([0-9]+) flashes, ([0-9]+) far layers")
  message(FATAL_ERROR "dump summary missing: ${out}")
endif()
set(n_flashes ${CMAKE_MATCH_4})
set(n_layers ${CMAKE_MATCH_5})
if(n_layers LESS 1 OR n_flashes LESS 1)
  message(FATAL_ERROR "the dump has ${n_layers} far layers and ${n_flashes} hit flashes: ${out}")
endif()
file(READ "${OUT}/dump/manifest.json" manifest)
string(JSON backgrounds GET "${manifest}" backgrounds)
string(JSON n_bg LENGTH "${backgrounds}")
string(JSON ring GET "${backgrounds}" 0 ring_lines)
if(NOT n_bg EQUAL n_layers OR NOT ring EQUAL 192)
  message(FATAL_ERROR "backgrounds in the manifest: ${n_bg} entries (ring_lines ${ring}), expected ${n_layers} of 192: ${backgrounds}")
endif()
message("dump: ${n_layers} far layer(s), ${n_flashes} hit flashes")

set(SCALE 2)
pictures(plain)
list(LENGTH plain n)
if(n LESS 250)
  message(FATAL_ERROR "only ${n} presented pictures")
endif()

# 2. The far layer alone.
file(COPY "${OUT}/dump/far_full" DESTINATION "${OUT}/bg")
write_pack("${OUT}/bg" ", \"backgrounds\": ${backgrounds}")
pictures(withbg --asset-pack "${OUT}/bg")
if(NOT withbg_out MATCHES "modern packs: ([0-9]+) steps with a background" OR CMAKE_MATCH_1 LESS 100)
  message(FATAL_ERROR "the background was not used: ${withbg_out}")
endif()
if(NOT withbg STREQUAL plain)
  count_diff("${withbg}" "${plain}" d)
  message(FATAL_ERROR "the dump's far layer as a background changes ${d} of ${n} pictures (it must reproduce them exactly)")
endif()
message("the dump's far layer as a background: ${n} pictures identical to the plain replay (${CMAKE_MATCH_1} steps used it)")
# A background that does not fit the build's ring (here: declared with another ring height) is not used.
file(COPY "${OUT}/dump/far_full" DESTINATION "${OUT}/wrongring")
string(JSON level GET "${backgrounds}" 0 level)
write_pack("${OUT}/wrongring" ", \"backgrounds\": [{\"level\": ${level}, \"png\": \"far_full/level${level}.png\", \"scale\": 1, \"ring_lines\": 96}]")
pictures(wrongring --asset-pack "${OUT}/wrongring")
if(wrongring_out MATCHES "steps with a background" OR NOT wrongring STREQUAL plain)
  message(FATAL_ERROR "a background with ring_lines 96 (the ring has 192) was used: ${wrongring_out}")
endif()
message("a background with the wrong ring height is not used")

# 3. Stars.
write_pack("${OUT}/stars_pixel" ", \"stars\": {\"shape\": \"pixel\"}")
pictures(stars_pixel --asset-pack "${OUT}/stars_pixel")
if(NOT stars_pixel STREQUAL plain)
  message(FATAL_ERROR "stars with the pixel shape change the pictures")
endif()
set(SCALE 4)
pictures(plain4)
write_pack("${OUT}/stars_round" ", \"stars\": {\"shape\": \"round\", \"size\": 2, \"softness\": 0.5}")
pictures(round_a --asset-pack "${OUT}/stars_round")
pictures(round_b --asset-pack "${OUT}/stars_round")
if(NOT round_a_out MATCHES "([0-9]+) round stars" OR CMAKE_MATCH_1 LESS 100)
  message(FATAL_ERROR "no round stars were drawn: ${round_a_out}")
endif()
count_diff("${round_a}" "${plain4}" d)
list(LENGTH plain4 n4)
if(d LESS 250)
  message(FATAL_ERROR "round stars change only ${d} of ${n4} pictures")
endif()
if(NOT round_a STREQUAL round_b)
  message(FATAL_ERROR "round stars are not deterministic")
endif()
message("round stars: ${CMAKE_MATCH_1} drawn, ${d} of ${n4} pictures differ from the pixel stars, repeatable")
if(RECOMP)
  pictures(round_interp --asset-pack "${OUT}/stars_round" --interp-only)
  if(NOT round_interp STREQUAL round_a)
    message(FATAL_ERROR "round stars differ between the translated executor and --interp-only")
  endif()
  message("round stars identical under the translated executor and --interp-only")
endif()
set(SCALE 2)

# 4. Hit flashes: the dump as a pack (explicit flash silhouettes), then the same without them (derived from the replaced bobs).
pictures(full --asset-pack "${OUT}/dump")
if(NOT full STREQUAL plain)
  message(FATAL_ERROR "the dump as a pack (with its hit flashes and far layer) does not reproduce the pictures")
endif()
if(NOT full_out MATCHES "([0-9]+) hit flashes replaced" OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "no hit flash was replaced by the dump's flash pictures: ${full_out}")
endif()
message("the dump as a pack: ${n} pictures identical, ${CMAKE_MATCH_1} hit flashes replaced by their own silhouettes")
file(COPY "${OUT}/dump/" DESTINATION "${OUT}/derived")
string(JSON graphics GET "${manifest}" graphics)
string(JSON count LENGTH "${graphics}")
set(removed 0)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
  string(JSON key MEMBER "${graphics}" ${i})
  if(key MATCHES "^f:")
    string(JSON manifest REMOVE "${manifest}" graphics "${key}")
    math(EXPR removed "${removed} + 1")
  endif()
endforeach()
if(NOT removed EQUAL n_flashes)
  message(FATAL_ERROR "removed ${removed} flash entries, expected ${n_flashes}")
endif()
file(WRITE "${OUT}/derived/manifest.json" "${manifest}\n")
pictures(derived --asset-pack "${OUT}/derived")
if(NOT derived_out MATCHES "([0-9]+) hit flashes replaced" OR CMAKE_MATCH_1 LESS 1)
  message(FATAL_ERROR "no hit flash was derived from a replaced bob: ${derived_out}")
endif()
count_diff("${derived}" "${plain}" d)
if(d LESS 1 OR d GREATER 40)
  message(FATAL_ERROR "derived flashes change ${d} of ${n} pictures (a flash lasts a few pictures)")
endif()
message("derived hit flashes: ${CMAKE_MATCH_1} replaced, ${d} of ${n} pictures differ (the flash frames only)")
