# The Atari ST release on the translated executor (docs/re-notes/atari-st-recomp.md): one script run twice, with --interp-only and with
# the hybrid executor, must give identical per-frame framebuffer hashes, audio hashes and state digests (RAM, registers, cycle counter,
# interrupt counts), identical frame logs (PC, SR and video base at every frame boundary) and an identical final RAM, with at least
# MIN_COVERAGE percent of the executed instructions translated.
# Usage: cmake -DX2RECOMP=<exe> -DASSETS=<assets-st dir> -DREPLAY=<script> -DOUT=<dir> [-DMIN_COVERAGE=90] -P st_equivalence.cmake
if(NOT EXISTS "${ASSETS}/disk.bin" OR NOT EXISTS "${ASSETS}/manifest.txt")
  message("SKIPPED: no Atari ST import in ${ASSETS} (x2recomp --import DISK.stx)")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED MIN_COVERAGE)
  set(MIN_COVERAGE 90)
endif()
file(STRINGS "${REPLAY}" frame_lines REGEX "^[ \t]*frames[ \t]+[0-9]+")
list(GET frame_lines -1 last_line)
string(REGEX MATCH "[0-9]+" nframes "${last_line}")
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
foreach(mode interp recomp)
  if(mode STREQUAL "interp")
    set(extra --interp-only)
  else()
    set(extra --recomp-stats 10)
  endif()
  execute_process(
    COMMAND "${X2RECOMP}" --game st --headless --assets "${ASSETS}" --input-script "${REPLAY}" --report-every 0
            --hash-every 1 --audio-hash --st-state-hash --st-frame-log "${OUT}/${mode}.frames"
            --st-ram-dump-at "${nframes}:${OUT}/${mode}.ram" ${extra}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out_${mode} ERROR_VARIABLE err)
  file(WRITE "${OUT}/${mode}.log" "${out_${mode}}${err}")
  if(NOT rc EQUAL 0)
    message("${out_${mode}}${err}")
    message(FATAL_ERROR "x2recomp --game st (${mode}) exited with ${rc}")
  endif()
endforeach()

set(failed FALSE)
foreach(mode interp recomp)
  string(REGEX MATCHALL "(frame|audio|state)hash [0-9]+ [0-9a-f]+" hashes_${mode} "${out_${mode}}")
endforeach()
list(LENGTH hashes_interp nh)
if(nh EQUAL 0)
  message(FATAL_ERROR "no frame hashes in the interpreter run")
endif()
if(NOT hashes_interp STREQUAL hashes_recomp)
  set(failed TRUE)
  message("frame/audio/state hashes DIFFER")
  list(LENGTH hashes_recomp nr)
  math(EXPR n "${nh} - 1")
  foreach(i RANGE ${n})
    list(GET hashes_interp ${i} a)
    list(GET hashes_recomp ${i} b)
    if(NOT a STREQUAL b)
      message("first difference: interpreter '${a}', translated '${b}'")
      break()
    endif()
  endforeach()
else()
  message("frame/audio/state hashes: ${nh} identical")
endif()

file(READ "${OUT}/interp.frames" fa)
file(READ "${OUT}/recomp.frames" fb)
if(NOT fa STREQUAL fb)
  set(failed TRUE)
  message("frame logs DIFFER")
else()
  message("frame logs identical")
endif()
file(SHA256 "${OUT}/interp.ram" a)
file(SHA256 "${OUT}/recomp.ram" b)
if(NOT a STREQUAL b)
  set(failed TRUE)
  message("final RAM DIFFERS")
else()
  message("final RAM identical")
endif()

if(out_recomp MATCHES "recomp: ([0-9]+) instructions, ([0-9]+) translated \\(([0-9.]+)%\\)")
  message("coverage: ${CMAKE_MATCH_2} of ${CMAKE_MATCH_1} executed instructions translated (${CMAKE_MATCH_3}%)")
  if(CMAKE_MATCH_3 LESS MIN_COVERAGE)
    set(failed TRUE)
    message("coverage below the ${MIN_COVERAGE}% target")
  endif()
else()
  set(failed TRUE)
  message("no recomp coverage line (was x2recomp built with -DX2_RECOMP=ON and the ST translation generated?)")
endif()

if(failed)
  message(FATAL_ERROR "ST recomp equivalence FAILED (logs in ${OUT})")
endif()
