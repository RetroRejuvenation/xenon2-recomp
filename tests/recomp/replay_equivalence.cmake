# Recompiler equivalence on one replay (tests/replays/*.txt): interpreter (--interp-only) vs hybrid executor must
# give identical per-frame framebuffer and audio hashes, per-frame register-write logs and final chip RAM, with at
# least MIN_COVERAGE percent of executed instructions translated.
# Usage: cmake -DX2RECOMP=<exe> -DASSETS=<dir> -DREPLAY=<file> -DOUT=<dir> [-DMIN_COVERAGE=90] -P replay_equivalence.cmake
if(NOT EXISTS "${ASSETS}/game_0400.bin" OR NOT EXISTS "${ASSETS}/disc2.bin")
  message("SKIPPED: no game data in ${ASSETS}; run tools/prep_assets.py with your own ADFs first")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED MIN_COVERAGE)
  set(MIN_COVERAGE 90)
endif()
file(REMOVE_RECURSE "${OUT}")
foreach(mode interp recomp)
  if(mode STREQUAL "interp")
    set(extra --interp-only)
  else()
    set(extra --recomp-stats 10)
  endif()
  execute_process(
    COMMAND "${X2RECOMP}" --headless --assets "${ASSETS}" --input-script "${REPLAY}" --dump-dir "${OUT}/${mode}"
            --report-every 0 --hash-every 1 --audio-hash ${extra}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out_${mode} ERROR_VARIABLE err)
  file(WRITE "${OUT}/${mode}.log" "${out_${mode}}${err}")
  if(NOT rc EQUAL 0)
    message("${out_${mode}}${err}")
    message(FATAL_ERROR "x2recomp (${mode}) exited with ${rc}")
  endif()
endforeach()

set(failed FALSE)
foreach(mode interp recomp)
  string(REGEX MATCHALL "(frame|audio)hash [0-9]+ [0-9a-f]+" hashes_${mode} "${out_${mode}}")
endforeach()
list(LENGTH hashes_interp nh)
if(nh EQUAL 0)
  message(FATAL_ERROR "no frame hashes in the interpreter run")
endif()
if(NOT hashes_interp STREQUAL hashes_recomp)
  set(failed TRUE)
  message("frame/audio hashes DIFFER")
else()
  message("frame/audio hashes: ${nh} identical")
endif()

file(GLOB logs RELATIVE "${OUT}/interp/regs" "${OUT}/interp/regs/*.log")
file(GLOB logs_r RELATIVE "${OUT}/recomp/regs" "${OUT}/recomp/regs/*.log")
if(NOT logs STREQUAL logs_r)
  set(failed TRUE)
  message("register logs: file lists differ")
else()
  set(nbad 0)
  foreach(f ${logs})
    file(SHA256 "${OUT}/interp/regs/${f}" a)
    file(SHA256 "${OUT}/recomp/regs/${f}" b)
    if(NOT a STREQUAL b)
      if(nbad EQUAL 0)
        message("FIRST REGISTER LOG DIFFERENCE: ${f}")
      endif()
      math(EXPR nbad "${nbad} + 1")
    endif()
  endforeach()
  list(LENGTH logs nl)
  if(nbad GREATER 0)
    set(failed TRUE)
    message("register logs: ${nbad} of ${nl} frames differ")
  else()
    message("register logs: ${nl} frames identical")
  endif()
endif()

file(SHA256 "${OUT}/interp/chipram.bin" a)
file(SHA256 "${OUT}/recomp/chipram.bin" b)
if(NOT a STREQUAL b)
  set(failed TRUE)
  message("chipram.bin: DIFFERS")
else()
  message("chipram.bin: identical")
endif()

if(out_recomp MATCHES "recomp: ([0-9]+) instructions, ([0-9]+) translated \\(([0-9.]+)%\\)")
  message("coverage: ${CMAKE_MATCH_2} of ${CMAKE_MATCH_1} executed instructions translated (${CMAKE_MATCH_3}%)")
  if(CMAKE_MATCH_3 LESS MIN_COVERAGE)
    set(failed TRUE)
    message("coverage below the ${MIN_COVERAGE}% target")
  endif()
else()
  set(failed TRUE)
  message("no recomp coverage line (was x2recomp built with -DX2_RECOMP=ON?)")
endif()

if(failed)
  message(FATAL_ERROR "recomp replay equivalence FAILED (logs in ${OUT})")
endif()
