# Full-game gate for the recompiler: the scripted title -> menu -> level 1 run (2000 frames) on the Musashi
# interpreter (--interp-only) and on the hybrid executor must give identical per-frame framebuffer hashes,
# identical frame/line-stamped register-write logs, a bit-identical audio WAV and identical final chip RAM.
# Also requires MIN_COVERAGE percent of executed instructions to run as translated code.
# Usage: cmake -DX2RECOMP=<exe> -DASSETS=<dir> -DOUT=<dir> [-DMIN_COVERAGE=90] -P equivalence.cmake  (CMake >= 3.29)
if(NOT EXISTS "${ASSETS}/game_0400.bin" OR NOT EXISTS "${ASSETS}/disc2.bin")
  message("SKIPPED: no game data in ${ASSETS}; run tools/prep_assets.py with your own ADFs first")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED MIN_COVERAGE)
  set(MIN_COVERAGE 90)
endif()

# Fire every 50 frames from 400 reaches level 1 (as in game_boot); then shoot in level 1 (bullets, sound effects,
# enemy hits). Uses only --fire so it runs on every x2recomp version.
set(input_args --frames 2000)
foreach(f RANGE 400 1350 50)
  list(APPEND input_args --fire ${f}:5)
endforeach()
list(APPEND input_args --fire 1400:150 --fire 1580:120 --fire 1720:200 --fire 1940:60)

file(REMOVE_RECURSE "${OUT}")
foreach(mode interp recomp)
  set(extra)
  if(mode STREQUAL "interp")
    set(extra --interp-only)
  else()
    set(extra --recomp-stats 25 --recomp-profile "${OUT}/recomp_profile.txt")
  endif()
  execute_process(
    COMMAND "${X2RECOMP}" --headless --assets "${ASSETS}" --dump-dir "${OUT}/${mode}" --report-every 500
            --hash-every 1 --audio-out "${OUT}/${mode}/audio.wav" ${input_args} ${extra}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out_${mode} ERROR_VARIABLE err)
  file(WRITE "${OUT}/${mode}.log" "${out_${mode}}${err}")
  if(NOT rc EQUAL 0)
    message("${out_${mode}}${err}")
    message(FATAL_ERROR "x2recomp (${mode}) exited with ${rc}")
  endif()
endforeach()

set(failed FALSE)
# 1. Per-frame framebuffer hashes.
foreach(mode interp recomp)
  string(REGEX MATCHALL "framehash [0-9]+ [0-9a-f]+" hashes_${mode} "${out_${mode}}")
  list(LENGTH hashes_${mode} n_${mode})
endforeach()
if(NOT n_interp EQUAL 2000)
  message(FATAL_ERROR "expected 2000 frame hashes, got ${n_interp}")
endif()
if(NOT hashes_interp STREQUAL hashes_recomp)
  set(failed TRUE)
  foreach(i RANGE 0 1999)
    list(GET hashes_interp ${i} a)
    list(GET hashes_recomp ${i} b)
    if(NOT a STREQUAL b)
      message("FIRST FRAME DIFFERENCE: interp '${a}' recomp '${b}'")
      break()
    endif()
  endforeach()
else()
  message("frames: 2000 framebuffer hashes identical")
endif()

# 2. Register-write logs (every custom/CIA write with frame, line, hpos, source and PC).
file(GLOB logs_interp RELATIVE "${OUT}/interp/regs" "${OUT}/interp/regs/*.log")
file(GLOB logs_recomp RELATIVE "${OUT}/recomp/regs" "${OUT}/recomp/regs/*.log")
list(LENGTH logs_interp nl)
if(NOT logs_interp STREQUAL logs_recomp OR NOT nl EQUAL 2000)
  set(failed TRUE)
  message("register logs: file lists differ (${nl} interp files)")
else()
  set(nbad 0)
  foreach(f ${logs_interp})
    file(SHA256 "${OUT}/interp/regs/${f}" a)
    file(SHA256 "${OUT}/recomp/regs/${f}" b)
    if(NOT a STREQUAL b)
      math(EXPR nbad "${nbad} + 1")
      if(nbad EQUAL 1)
        message("FIRST REGISTER LOG DIFFERENCE: ${f}")
      endif()
    endif()
  endforeach()
  if(nbad GREATER 0)
    set(failed TRUE)
    message("register logs: ${nbad} of ${nl} frames differ")
  else()
    message("register logs: ${nl} frames identical")
  endif()
endif()

# 3. Audio and final memory, bit exact.
foreach(f audio.wav chipram.bin)
  file(SHA256 "${OUT}/interp/${f}" a)
  file(SHA256 "${OUT}/recomp/${f}" b)
  if(NOT a STREQUAL b)
    set(failed TRUE)
    message("${f}: DIFFERS")
  else()
    message("${f}: identical (sha256 ${a})")
  endif()
endforeach()

# 4. Coverage of the hybrid run.
if(out_recomp MATCHES "recomp: ([0-9]+) instructions, ([0-9]+) translated \\(([0-9.]+)%\\)")
  set(coverage ${CMAKE_MATCH_3})
  string(REGEX MATCH "recomp: [0-9]+ instructions[^\n]*(\n  interpreted[^\n]*)*" summary "${out_recomp}")
  message("${summary}")
  if(coverage LESS MIN_COVERAGE)
    set(failed TRUE)
    message("coverage ${coverage}% is below the ${MIN_COVERAGE}% target")
  endif()
else()
  set(failed TRUE)
  message("no recomp coverage line in the hybrid run's output (was x2recomp built with -DX2_RECOMP=ON?)")
endif()

if(failed)
  message(FATAL_ERROR "recomp_equivalence FAILED (logs in ${OUT})")
endif()
message("recomp_equivalence passed")
