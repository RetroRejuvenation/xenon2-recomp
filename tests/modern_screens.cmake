# Screens and the status panel from asset packs on a real game build (docs/re-notes/asset-packs-screens.md). Exits 77 (CTest "Skipped")
# without the user's assets. Everything it writes stays in OUT (the dump is the user's own game graphics: never commit it).
# Usage: cmake -DX2RECOMP=<exe> -DGAME=disk|cdtv|st -DASSETS=<dir> -DREPLAY=<script> -DOUT=<dir> -DMIN_SCREENS=<n> [-DPANEL=1]
#        [-DSCALES=2;3] -P modern_screens.cmake
#  1. --dump-assets writes the screens and the panel cells of the replay (a version 2 pack at scale 1).
#  2. The dump loaded as a pack gives, at each canvas scale in SCALES, exactly the frames the game rendered: every frame a screen or the
#     panel was drawn on is identical to the faithful frame (enlarged), except while the game fades (the fit is within one colour level)
#     and while the strip's palette is not the pack's in a way a fade does not explain (counted, never more than 3 % of the frames).
#     No frame may differ otherwise.
#  2b. The same dump as a ZIP gives the same result.
#  3. The result does not depend on the run (a second run prints the same summary).
#  4. (Amiga builds) With the Faithful switch the pictures are those of the run without the pack.
if(GAME STREQUAL "st")
  set(have "${ASSETS}/disk.bin")
  set(base "${X2RECOMP}" --headless --game st --assets "${ASSETS}" --report-every 0 --input-script "${REPLAY}")
else()
  set(have "${ASSETS}/game_0400.bin")
  set(base "${X2RECOMP}" --headless --assets "${ASSETS}" --no-reglog --report-every 0 --input-script "${REPLAY}")
endif()
if(NOT EXISTS "${have}")
  message("SKIPPED: no game data in ${ASSETS}")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED SCALES)
  set(SCALES 2)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(run out_var)
  execute_process(COMMAND ${base} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp ${ARGN} exited with ${rc}: ${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# 1. The dump.
run(out --dump-assets "${OUT}/dump")
if(NOT out MATCHES "dump-assets: ([0-9]+) screens \\(([0-9]+) transitions skipped, ([0-9]+) not matchable\\), ([0-9]+) panel cells"
   OR CMAKE_MATCH_1 LESS ${MIN_SCREENS} OR NOT EXISTS "${OUT}/dump/manifest.json")
  message(FATAL_ERROR "dump incomplete (wanted at least ${MIN_SCREENS} screens): ${out}")
endif()
set(screens ${CMAKE_MATCH_1})
set(cells ${CMAKE_MATCH_4})
if(PANEL AND cells LESS 20)
  message(FATAL_ERROR "only ${cells} panel cells in the dump")
endif()
file(READ "${OUT}/dump/manifest.json" manifest)
if(NOT manifest MATCHES "\"version\": 2" OR NOT manifest MATCHES "\"screens\": \\{")
  message(FATAL_ERROR "the dump is not a version 2 manifest with screens")
endif()
message("dump: ${screens} screens, ${cells} panel cells")

# 2. The dump as a pack reproduces the frames.
foreach(scale IN LISTS SCALES)
  run(out --asset-pack "${OUT}/dump" --modern upgrade,scale=${scale} --modern-check)
  if(NOT out MATCHES "screens check: ([0-9]+) frames with a screen or the panel, ([0-9]+) identical to the frame; screens drawn in ([0-9]+) frames \\(([0-9]+) fading, ([0-9]+) of those identical, largest channel error ([0-9]+)\\), panel drawn in ([0-9]+); ([0-9]+) differ with a palette[^;]*, ([0-9]+) differ otherwise")
    message(FATAL_ERROR "scale ${scale}: no screens check line in: ${out}")
  endif()
  set(frames ${CMAKE_MATCH_1})
  set(exact ${CMAKE_MATCH_2})
  set(drawn ${CMAKE_MATCH_3})
  set(fading ${CMAKE_MATCH_4})
  set(fading_exact ${CMAKE_MATCH_5})
  set(fade_err ${CMAKE_MATCH_6})
  set(panel_frames ${CMAKE_MATCH_7})
  set(palette ${CMAKE_MATCH_8})
  set(bad ${CMAKE_MATCH_9})
  string(REGEX MATCH "screens check: [^\n]*" summary "${out}")
  if(drawn LESS 50)
    message(FATAL_ERROR "scale ${scale}: screens drawn in only ${drawn} frames")
  endif()
  if(PANEL AND panel_frames LESS 500)
    message(FATAL_ERROR "scale ${scale}: panel drawn in only ${panel_frames} frames")
  endif()
  if(NOT bad EQUAL 0)
    message(FATAL_ERROR "scale ${scale}: ${bad} frames differ from the original outside fades and palette changes: ${summary}")
  endif()
  if(fade_err GREATER 1)
    message(FATAL_ERROR "scale ${scale}: a fading screen is off by ${fade_err} colour steps (at most 1 allowed): ${summary}")
  endif()
  math(EXPR palette_limit "${frames} * 3 / 100")
  if(palette GREATER palette_limit)
    message(FATAL_ERROR "scale ${scale}: ${palette} of ${frames} frames have a palette the pack cannot follow: ${summary}")
  endif()
  message("scale ${scale}: ${summary}")
  if(scale EQUAL 2)
    set(first_summary "${summary}")
  endif()
endforeach()

# 2b. The same dump as a ZIP pack (made by cmake itself, members at the root) gives the same line as the directory.
file(GLOB members RELATIVE "${OUT}/dump" "${OUT}/dump/*")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUT}/dump.zip" --format=zip -- ${members}
                WORKING_DIRECTORY "${OUT}/dump" RESULT_VARIABLE zip_rc ERROR_VARIABLE zip_err)
if(NOT zip_rc EQUAL 0 OR NOT EXISTS "${OUT}/dump.zip")
  message(FATAL_ERROR "could not zip the dump: ${zip_err}")
endif()
foreach(scale IN LISTS SCALES)
  run(dir_out --asset-pack "${OUT}/dump" --modern upgrade,scale=${scale} --modern-check)
  run(zip_out --asset-pack "${OUT}/dump.zip" --modern upgrade,scale=${scale} --modern-check)
  string(REGEX MATCH "screens check: [^\n]*" dir_line "${dir_out}")
  string(REGEX MATCH "screens check: [^\n]*" zip_line "${zip_out}")
  if(dir_line STREQUAL "" OR NOT dir_line STREQUAL zip_line)
    message(FATAL_ERROR "scale ${scale}: the ZIP pack differs from the directory pack:\n${dir_line}\n${zip_line}")
  endif()
endforeach()
message("ZIP pack: the same result as the directory pack")

# 3. Determinism: the second run prints the same line.
list(FIND SCALES 2 has_two)
if(NOT has_two EQUAL -1)
  run(out --asset-pack "${OUT}/dump" --modern upgrade,scale=2 --modern-check)
  string(REGEX MATCH "screens check: [^\n]*" again "${out}")
  if(NOT again STREQUAL first_summary)
    message(FATAL_ERROR "a second run gave a different result:\n${first_summary}\n${again}")
  endif()
endif()

# 4. Faithful: no pack effect at all (Amiga builds; the Atari ST window has no picture hashes to compare).
if(NOT GAME STREQUAL "st" AND DEFINED FAITHFUL_FROM)
  run(plain --modern scale=2 --modern-out ${FAITHFUL_FROM}-${FAITHFUL_TO}:-)
  run(faithful --asset-pack "${OUT}/dump" --modern faithful,scale=2 --modern-out ${FAITHFUL_FROM}-${FAITHFUL_TO}:-)
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" a "${plain}")
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" b "${faithful}")
  list(LENGTH a n)
  if(n LESS 100 OR NOT a STREQUAL b)
    message(FATAL_ERROR "Faithful with a pack differs from the run without it (${n} pictures)")
  endif()
  run(packed --asset-pack "${OUT}/dump" --modern upgrade,scale=2 --modern-out ${FAITHFUL_FROM}-${FAITHFUL_TO}:-)
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" c "${packed}")
  if(c STREQUAL a)
    message(FATAL_ERROR "the pack changed no picture in frames ${FAITHFUL_FROM}-${FAITHFUL_TO}: the Faithful comparison proves nothing")
  endif()
  message("Faithful with the pack: ${n} pictures identical to the run without it")
endif()
