# End-to-end check of the game builds, the one-disk crunches and the extra cracks with real disk images (your own files, any
# folder; the default is the git-ignored generated/sources-extra laid out as docs/re-notes/sources.md describes): every image is
# imported through `x2recomp --import` and must give the documented outcome - the recorded game image and disc 2 (sha1
# checked), a manifest naming the variant (and the build= tag the runtime starts it by), and the recorded replay hashes of its
# own (tests/replays/<build>/ and tests/replays/cracks/<id>/).
#   - The Power Pack (SPS 2234), from the preservation IPF and from the WHDLoad install's Disk.1 (the same bytes both ways).
#   - The Bombuzal + Xenon 2 compilation (SPS 1762), from the IPF pair and from the WHDLoad install, and its pairing rules.
#   - The one-disk crunches (Vision Factory, VF [a], Black Monks [h][t +36]): disc 2 rebuilt, or the standard disc 2 used as is.
#   - The cracked retail disk 1 images that need a recipe beyond "plain at $70C00": PNA [a] (trainer) and Black Monks (tail).
# Each group is skipped when its images are not there; the test exits 77 (Skipped) when none of them is.
# Usage: cmake -DX2RECOMP=<exe> -DSRC=<folder with ipf/, whd/ and tosec2010-adf/> -DSRC2=<folder with the Amiga_EN archive's
#              extracted zips> -DDISC2=<canonical disk 2 ADF> -DREPLAYS=<tests/replays> -DOUT=<scratch dir> -P builds_import.cmake
set(CANONICAL_DISC2_SHA1 "a748afc7a142335a40cc46fb7785dea820770241")
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
set(n_checked 0)

function(import_case name expect_rc)
  set(inputs ${ARGN})
  file(MAKE_DIRECTORY "${OUT}/${name}")
  execute_process(COMMAND "${X2RECOMP}" --import ${inputs} --assets "${OUT}/${name}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(CASE_RC "${rc}" PARENT_SCOPE)
  set(CASE_OUT "${out}${err}" PARENT_SCOPE)
  if(NOT rc EQUAL ${expect_rc})
    message(FATAL_ERROR "${name}: expected exit code ${expect_rc}, got ${rc}\n${out}${err}")
  endif()
endfunction()

function(expect_text name text)
  string(FIND "${CASE_OUT}" "${text}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "${name}: the output lacks \"${text}\"\n${CASE_OUT}")
  endif()
endfunction()

function(expect_manifest name)
  file(READ "${OUT}/${name}/manifest.txt" manifest)
  foreach(want ${ARGN})
    string(FIND "${manifest}" "${want}\n" pos)
    if(pos EQUAL -1)
      message(FATAL_ERROR "${name}: the manifest lacks ${want}\n${manifest}")
    endif()
  endforeach()
endfunction()

function(expect_no_manifest_line name prefix)
  file(READ "${OUT}/${name}/manifest.txt" manifest)
  string(FIND "${manifest}" "\n${prefix}" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "${name}: the manifest has an unexpected ${prefix} line\n${manifest}")
  endif()
endfunction()

function(expect_sha1 name file want)
  file(SHA1 "${OUT}/${name}/${file}" got)
  if(NOT got STREQUAL "${want}")
    message(FATAL_ERROR "${name}: ${file} has sha1 ${got}, expected ${want}")
  endif()
endfunction()

function(replay_matches name goldens replay)
  execute_process(COMMAND "${CMAKE_COMMAND}" -DX2RECOMP=${X2RECOMP} -DASSETS=${OUT}/${name}
      -DREPLAY=${REPLAYS}/${replay}.txt -DHASHES=${goldens}/${replay}.hashes -P "${CMAKE_CURRENT_LIST_DIR}/replay_check.cmake"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: ${replay} does not match ${goldens}/${replay}.hashes\n${out}${err}")
  endif()
endfunction()

macro(checked)
  math(EXPR n_checked "${n_checked} + 1")
endmacro()

# --- the Power Pack (SPS 2234) -----------------------------------------------------------------------------------------
set(PP_GAME "1d383dc38df7430332e46590ea370f87837c9e6d")
set(PP_DISC2 "70f40c468ee8295c676bc4fa994b03d6fd1abd8e")
set(PP_IPF "${SRC}/ipf/2234/Xenon2-Megablast.ipf")
set(PP_WHD "${SRC}/whd/Xenon2_v1.9_1Disk_2234.zip")
foreach(case "ipf|${PP_IPF}|IPF" "whd|${PP_WHD}|ZIP")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 tag)
  list(GET parts 1 file)
  if(EXISTS "${file}")
    import_case(power_pack_${tag} 0 "${file}")
    expect_sha1(power_pack_${tag} game_0400.bin "${PP_GAME}")
    expect_sha1(power_pack_${tag} disc2.bin "${PP_DISC2}")
    expect_manifest(power_pack_${tag} "build=power-pack-2234" "variant=power-pack-2234" "canonical=false" "patched=false" "disc2_rebuilt=true" "copylock=absent")
    expect_no_manifest_line(power_pack_${tag} "trainer=")
    expect_text(power_pack_${tag} "different build of the game")
    if(NOT EXISTS "${OUT}/power_pack_${tag}/copylock.txt")
      foreach(replay level1_play ending_natural boss1)
        replay_matches(power_pack_${tag} "${REPLAYS}/power-pack-2234" ${replay})
      endforeach()
    else()
      message(FATAL_ERROR "the Power Pack import must not carry a Copylock receipt")
    endif()
    checked()
  else()
    message("note: ${file} is not available; its Power Pack check was not run")
  endif()
endforeach()
if(EXISTS "${PP_IPF}")
  # a disc 2 given as well is not used: the Power Pack holds its own game data
  import_case(power_pack_extra_disc2 0 "${PP_IPF}" "${DISC2}")
  expect_sha1(power_pack_extra_disc2 disc2.bin "${PP_DISC2}")
  expect_text(power_pack_extra_disc2 "holds its own game data")
  # --diagnose-image names the layout
  execute_process(COMMAND "${X2RECOMP}" --diagnose-image "${PP_IPF}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT out MATCHES "157 of 157 decode; the Power Pack \\(Speedlock\\) layout")
    message(FATAL_ERROR "--diagnose-image on the Power Pack: rc=${rc}\n${out}${err}")
  endif()
endif()

# --- the Bombuzal + Xenon 2 compilation (SPS 1762) ----------------------------------------------------------------------
set(C1762_GAME "a665f6592f5c62f13aedd80669245b4370d48635")
set(C1762_DISC2 "c294d6644f9d5b20056b46f004cd8ec891b01440")
set(C1762_D1 "${SRC}/ipf/1762/Xenon2-Megablast_Disk1.ipf")
set(C1762_D2 "${SRC}/ipf/1762/Xenon2-Megablast_Disk2.ipf")
set(C1762_WHD "${SRC}/whd/Xenon 2 - Megablast (Bitmap Brothers)(2005)[pa Wepl][pv 1.9][IPF1762][WHD].zip")
foreach(case "ipf|${C1762_D1}|${C1762_D2}" "whd|${C1762_WHD}|-")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 tag)
  list(GET parts 1 f1)
  list(GET parts 2 f2)
  if(EXISTS "${f1}")
    if(f2 STREQUAL "-")
      import_case(c1762_${tag} 0 "${f1}")
    else()
      import_case(c1762_${tag} 0 "${f1}" "${f2}")
    endif()
    expect_sha1(c1762_${tag} game_0400.bin "${C1762_GAME}")
    expect_sha1(c1762_${tag} disc2.bin "${C1762_DISC2}")
    expect_manifest(c1762_${tag} "build=compilation-1762" "variant=compilation-1762" "canonical=false" "patched=false" "copylock=absent")
    expect_no_manifest_line(c1762_${tag} "disc2_rebuilt=")
    foreach(replay level1_play ending_natural boss1)
      replay_matches(c1762_${tag} "${REPLAYS}/compilation-1762" ${replay})
    endforeach()
    checked()
  else()
    message("note: ${f1} is not available; its 1762 check was not run")
  endif()
endforeach()
if(EXISTS "${C1762_D1}" AND EXISTS "${DISC2}")
  # disk 1 with the canonical disc 2: a different build's data, refused
  import_case(c1762_wrong_d2 3 "${C1762_D1}" "${DISC2}")
  expect_text(c1762_wrong_d2 "needs its own disk 2")
  # the compilation's disk 2 with a canonical disc 1 is refused as well
  set(T "${SRC}/tosec2010-adf")
  set(D1 "Xenon 2 - Megablast (1989)(Image Works)(Disk 1 of 2)")
  if(EXISTS "${T}/${D1}[cr PNA].adf" AND EXISTS "${C1762_D2}")
    import_case(c1762_wrong_d1 3 "${T}/${D1}[cr PNA].adf" "${C1762_D2}")
    expect_text(c1762_wrong_d1 "different build of the game than disc 1")
  endif()
  # disk 1 alone
  import_case(c1762_alone 3 "${C1762_D1}")
  expect_text(c1762_alone "needs its own disk 2")
  checked()
endif()

# --- the one-disk crunches ------------------------------------------------------------------------------------------------
set(T "${SRC}/tosec2010-adf")
set(REBUILT_DISC2 "6c10b7bd28f4d18f8411d35f30697a4b0ea71a6e")
foreach(case
    "crack-vf|[cr PNA][h VF][t +1 VF]|2cae13f13a5ed9129d28a2eeb8c67e1c3558fb20|false"
    "crack-vf-a|[cr PNA][h VF][t +1 VF][a]|f1f50fa3eefd5bdd551ff3598c0dd905f834867a|false"
    "crack-black-monks-h|[cr BS1][h Black Monks][t +36 Black Monks]|5ddb872b2a5c843d3ed0c0a5738b41c2e1711aa7|true")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 id)
  list(GET parts 1 tag)
  list(GET parts 2 want)
  list(GET parts 3 trainer)
  set(file "${T}/Xenon 2 - Megablast (1989)(Image Works)${tag}.adf")
  if(EXISTS "${file}")
    import_case(${id} 0 "${file}")
    expect_sha1(${id} game_0400.bin "${want}")
    expect_sha1(${id} disc2.bin "${REBUILT_DISC2}")
    expect_manifest(${id} "variant=${id}" "canonical=false" "patched=false" "copylock=absent" "disc2_rebuilt=true")
    expect_no_manifest_line(${id} "build=")
    if(trainer)
      expect_manifest(${id} "trainer=true")
    else()
      expect_no_manifest_line(${id} "trainer=")
    endif()
    expect_text(${id} "one-disk crunch")
    foreach(replay level1_play ending_natural)
      replay_matches(${id} "${REPLAYS}/cracks/${id}" ${replay})
    endforeach()
    if(EXISTS "${DISC2}")
      # with the standard disc 2 as well, that exact disc is used (the replay hashes are the same either way)
      import_case(${id}_std 0 "${file}" "${DISC2}")
      expect_sha1(${id}_std game_0400.bin "${want}")
      expect_sha1(${id}_std disc2.bin "${CANONICAL_DISC2_SHA1}")
      expect_no_manifest_line(${id}_std "disc2_rebuilt=")
      replay_matches(${id}_std "${REPLAYS}/cracks/${id}" level1_play)
    endif()
    checked()
  else()
    message("note: ${file} is not available; its one-disk check was not run")
  endif()
endforeach()

# --- PNA [a] and Black Monks: cracked copies of the retail disk 1 with their own recipes -------------------------------------
set(PNA_A "${SRC2}/Xenon-2-Megablast_Amiga_EN/z02/Xenon II - Megablast (1989)(ImageWorks)(Disk 1 of 2)[cr PNA][a].adf")
set(BM "${T}/Xenon 2 - Megablast (1989)(Image Works)(Disk 1 of 2)[cr Black Monks].adf")
foreach(case
    "crack-pna-a|${PNA_A}|2232da1c9a75e0d54b4025ee963d604ffd1d053b"
    "crack-black-monks|${BM}|976f09d2f50c5d3bde2dbd7c68cca7d8964a3a5e")
  string(REPLACE "|" ";" parts "${case}")
  list(GET parts 0 id)
  list(GET parts 1 file)
  list(GET parts 2 want)
  if(EXISTS "${file}" AND EXISTS "${DISC2}")
    import_case(${id} 0 "${file}" "${DISC2}")
    expect_sha1(${id} game_0400.bin "${want}")
    expect_sha1(${id} disc2.bin "${CANONICAL_DISC2_SHA1}")
    expect_manifest(${id} "variant=${id}" "canonical=false" "patched=false" "copylock=absent" "trainer=true")
    expect_text(${id} "carries a trainer")
    foreach(replay level1_play ending_natural)
      replay_matches(${id} "${REPLAYS}/cracks/${id}" ${replay})
    endforeach()
    checked()
  else()
    message("note: ${file} (or the standard disc 2) is not available; its crack check was not run")
  endif()
endforeach()

if(n_checked EQUAL 0)
  message("SKIPPED: none of the Power Pack, 1762, one-disk or crack images is available under ${SRC}")
  cmake_language(EXIT 77)
endif()
message("builds, one-disk crunches and cracks: ${n_checked} groups checked out")
