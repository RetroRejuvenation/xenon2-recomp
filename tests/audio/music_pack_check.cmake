# Asset-pack music on the real game (docs/re-notes/asset-packs-music.md): one replay run headless with a synthetic music pack
# (written by `x2_music_slots_tests FIXTURES --write-pack DIR GAME`, no game audio).
#   - the pack changes only the audio: the frame hashes are the corpus's, the audio hashes are the recorded pack ones (PACK_HASHES);
#   - with --faithful and with --modern noaudio the audio hashes are the corpus's again (HASHES);
#   - the cue log names the pack slots (EXPECT_CUES, a ";"-list of regular expressions, each must match a cue line).
# Usage: cmake -DX2RECOMP=<exe> -DTESTEXE=<x2_music_slots_tests> -DASSETS=<dir> -DREPLAY=<name.txt> -DHASHES=<corpus .hashes>
#              -DPACK_HASHES=<recorded .hashes> -DGAME=disk|cdtv -DOUT=<dir> -DEXPECT_CUES=<list> -P music_pack_check.cmake
# Exits 77 (CTest "Skipped") without game data. Record PACK_HASHES by running with -DRECORD=ON and copying the printed lines.
if(NOT EXISTS "${ASSETS}/game_0400.bin")
  message("SKIPPED: no game data in ${ASSETS}")
  cmake_language(EXIT 77)
endif()
if(GAME STREQUAL "cdtv")
  file(STRINGS "${ASSETS}/manifest.txt" build_line REGEX "^build=cdtv")
  if(NOT build_line)
    message("SKIPPED: ${ASSETS} is not a CDTV release import")
    cmake_language(EXIT 77)
  endif()
  set(game_args --game cdtv)
elseif(NOT EXISTS "${ASSETS}/disc2.bin")
  message("SKIPPED: no disc 2 in ${ASSETS}")
  cmake_language(EXIT 77)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")
execute_process(COMMAND "${TESTEXE}" "-" --write-pack "${OUT}/pack" "${GAME}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "could not write the synthetic pack (${rc})")
endif()

file(STRINGS "${PACK_HASHES}" want REGEX "^(frame|audio)hash [0-9]+ [0-9a-f]+$")
file(STRINGS "${HASHES}" corpus REGEX "^(frame|audio)hash [0-9]+ [0-9a-f]+$")
set(hash_args)
set(base_want)
foreach(line IN LISTS want)
  if(line MATCHES "^framehash ([0-9]+) ")
    list(APPEND hash_args --hash-at ${CMAKE_MATCH_1})
  endif()
endforeach()
foreach(line IN LISTS corpus)
  if(line MATCHES "^[a-z]+hash ([0-9]+) ")
    list(FIND hash_args ${CMAKE_MATCH_1} at)
    if(NOT at EQUAL -1)
      list(APPEND base_want "${line}")
    endif()
  endif()
endforeach()

function(play outvar logfile)
  execute_process(
    COMMAND "${X2RECOMP}" ${game_args} --headless --report-every 0 --assets "${ASSETS}" --input-script "${REPLAY}" --audio-hash
            --cdtv-log "${logfile}" ${hash_args} ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp exited with ${rc}\n${out}${err}")
  endif()
  string(REGEX MATCHALL "(frame|audio)hash [0-9]+ [0-9a-f]+" got "${out}")
  set(${outvar} "${got}" PARENT_SCOPE)
endfunction()
function(of_kind kind in out)
  set(r)
  foreach(l IN LISTS in)
    if(l MATCHES "^${kind}hash ")
      list(APPEND r "${l}")
    endif()
  endforeach()
  set(${out} "${r}" PARENT_SCOPE)
endfunction()

play(with_pack "${OUT}/cues.log" --asset-pack "${OUT}/pack")
if(RECORD)
  message("${with_pack}")
endif()
of_kind(frame "${with_pack}" got_frames)
of_kind(frame "${want}" want_frames)
of_kind(audio "${with_pack}" got_audio)
of_kind(audio "${want}" want_audio)
if(NOT got_frames STREQUAL want_frames)
  message(FATAL_ERROR "a music pack changed the picture\n--- expected\n${want_frames}\n--- got\n${got_frames}")
endif()
if(NOT got_audio STREQUAL want_audio)
  message(FATAL_ERROR "pack audio hashes differ from ${PACK_HASHES}\n--- expected\n${want_audio}\n--- got\n${got_audio}")
endif()
of_kind(audio "${base_want}" base_audio)
if(got_audio STREQUAL base_audio)
  message(FATAL_ERROR "the pack's music is not in the audio (hashes equal the corpus's)")
endif()

foreach(switch --faithful --modern=noaudio)
  if(switch STREQUAL "--modern=noaudio")
    play(off "${OUT}/off.log" --asset-pack "${OUT}/pack" --modern noaudio)
  else()
    play(off "${OUT}/off.log" --asset-pack "${OUT}/pack" ${switch})
  endif()
  of_kind(audio "${off}" off_audio)
  if(NOT off_audio STREQUAL base_audio)
    message(FATAL_ERROR "${switch}: the audio is not the original's\n--- expected\n${base_audio}\n--- got\n${off_audio}")
  endif()
endforeach()

file(STRINGS "${OUT}/cues.log" cues)
foreach(re IN LISTS EXPECT_CUES)
  set(found FALSE)
  foreach(c IN LISTS cues)
    if(c MATCHES "${re}")
      set(found TRUE)
    endif()
  endforeach()
  if(NOT found)
    string(REPLACE ";" "\n" cue_text "${cues}")
    message(FATAL_ERROR "no cue matches ${re}\n${cue_text}")
  endif()
endforeach()
message("pack music: hashes, off switches and cues as expected")
