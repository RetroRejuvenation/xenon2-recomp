# What a release package would carry, checked from the install rules and the packaging scripts without building a package: the install puts the
# user documents (including the launcher guide) and every licence text next to the executable, nothing in it is game data, and the two
# packaging scripts check for the same licence files the install rules ship.
# Usage: cmake -DSRC=<source dir> -DBUILD=<build dir> -DOUT=<scratch dir> [-DCONFIG=<config>] -P package_contents_check.cmake
file(REMOVE_RECURSE "${OUT}")
set(cfg)
if(CONFIG)
  set(cfg --config "${CONFIG}")  # multi-configuration generators (Visual Studio) need to know which build to install
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BUILD}" ${cfg} --prefix "${OUT}/install" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "cmake --install failed: ${err}")
endif()
file(GLOB_RECURSE installed RELATIVE "${OUT}/install" "${OUT}/install/*")
function(need name)
  set(hit FALSE)
  foreach(f IN LISTS installed)
    get_filename_component(base "${f}" NAME)
    if("${base}" STREQUAL "${name}")
      set(hit TRUE)
    endif()
  endforeach()
  if(NOT hit)
    message(FATAL_ERROR "the install lacks ${name}")
  endif()
endfunction()
foreach(doc LICENSE README.md THIRD-PARTY-NOTICES.md PROVENANCE.md BUILDING.md GUI.md ASSET-PACKS.md ASSET-PACKS-REFERENCE.md PORTING.md DUMPING.md)
  need("${doc}")
endforeach()
# The tutorials of docs/asset-packs/ travel as a folder.
file(GLOB tutorials RELATIVE "${SRC}/docs/asset-packs" "${SRC}/docs/asset-packs/*.md")
foreach(t IN LISTS tutorials)
  need("${t}")
endforeach()
# Every licence text the sources list is installed, and both packaging scripts check for it.
file(GLOB lic_sources RELATIVE "${SRC}/packaging/licenses" "${SRC}/packaging/licenses/*")
foreach(l IN LISTS lic_sources)
  need("${l}")
endforeach()
file(READ "${SRC}/tools/package.sh" sh)
file(READ "${SRC}/tools/package.ps1" ps)
foreach(l README.txt Musashi-LICENSE.txt puff-LICENSE.txt Unscii-LICENSE.txt dr_flac-LICENSE.txt stb_vorbis-LICENSE.txt)
  need("${l}")
  string(FIND "${sh}" "${l}" at_sh)
  string(FIND "${ps}" "${l}" at_ps)
  if(at_sh EQUAL -1 OR at_ps EQUAL -1)
    message(FATAL_ERROR "a packaging script does not check for ${l}")
  endif()
endforeach()
# GUI.md is named by both scripts' headers, so the documentation of a release says what it carries.
string(FIND "${sh}" "GUI.md" at_sh)
string(FIND "${ps}" "GUI.md" at_ps)
if(at_sh EQUAL -1 OR at_ps EQUAL -1)
  message(FATAL_ERROR "a packaging script's header does not list GUI.md")
endif()
# Nothing derived from game data.
foreach(f IN LISTS installed)
  if(f MATCHES "\\.(adf|adz|dms|ipf|zip|iso|cue|rom|wav|pcm|ppm)$" OR f MATCHES "(^|/)(x2r_|x2rc_|x2rs_)" OR f MATCHES "(manifest\\.txt|settings\\.cfg|input\\.cfg)$" OR f MATCHES "game_0400\\.bin")
    message(FATAL_ERROR "the install would carry a forbidden file: ${f}")
  endif()
endforeach()
list(LENGTH installed n)
message("package_contents: ${n} installed files; the documents, the licence texts and the packaging checks agree; nothing forbidden")
