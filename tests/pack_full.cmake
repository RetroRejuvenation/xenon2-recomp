# Everything a pack can carry at once, on a real game build, and what it costs (docs/re-notes/asset-packs-v2-design.md section 9).
# Exits 77 (CTest "Skipped") without the user's assets. Everything it writes stays in OUT (the dumps are the user's own game material:
# never commit them).
# Usage: cmake -DX2RECOMP=<exe> -DGAME=disk|cdtv|st -DASSETS=<dir> -DREPLAY=<script for the cost> -DOUT=<dir>
#        [-DEQ_REPLAY=<script> -DEQ_FRAMES=<n> -DEQ_FROM=<n> -DEQ_TO=<n>] [-DMAX_OVERHEAD=0.25] [-DRUNS=3] -P pack_full.cmake
#  1. --dump-assets (graphics, screens, panel, backgrounds) and, on the Amiga builds, --dump-audio write a replay's own material
#     (EQ_REPLAY for the check below, REPLAY for the cost).
#  2. Both dumps of EQ_REPLAY loaded together (layered, as a directory), the presented pictures of frames EQ_FROM..EQ_TO are exactly those of
#     the run without packs (outside the fades, where a screen fits to within one colour level: see modern_screens.cmake), and the run
#     is repeatable: a second run gives the same pictures. (Atari ST: the screens check reports no differing frame.)
#  3. The cost: the REPLAY run with both of its dumps takes at most MAX_OVERHEAD (default 0.25 = 25 %) longer than the run without,
#     best of RUNS runs each, at canvas scale 3. The design's budget is 5 % for graphics and 3 % for audio on an idle machine; the gate is
#     deliberately wider so that a busy runner does not fail it, and the measured figures are printed.
if(GAME STREQUAL "st")
  set(have "${ASSETS}/disk.bin")
  set(common "${X2RECOMP}" --headless --game st --assets "${ASSETS}" --report-every 0)
else()
  set(have "${ASSETS}/game_0400.bin")
  set(common "${X2RECOMP}" --headless --assets "${ASSETS}" --no-reglog --report-every 0)
endif()
if(NOT DEFINED EQ_REPLAY)
  set(EQ_REPLAY "${REPLAY}")
endif()
set(base ${common} --input-script "${REPLAY}")
if(NOT EXISTS "${have}")
  message("SKIPPED: no game data in ${ASSETS}")
  cmake_language(EXIT 77)
endif()
if(NOT DEFINED MAX_OVERHEAD)
  set(MAX_OVERHEAD 0.25)
endif()
if(NOT DEFINED RUNS)
  set(RUNS 3)
endif()
file(REMOVE_RECURSE "${OUT}")
file(MAKE_DIRECTORY "${OUT}")

function(run out_var)
  execute_process(COMMAND ${base} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp ${ARGN} exited with ${rc}: ${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# seconds taken by one run (cmake -E time prints "Elapsed time (seconds): N")
function(timed seconds_var)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E time ${base} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp ${ARGN} exited with ${rc}: ${err}")
  endif()
  if(NOT "${out}${err}" MATCHES "Elapsed time \\(seconds\\): ([0-9.]+)")
    message(FATAL_ERROR "no elapsed time in: ${out}${err}")
  endif()
  set(${seconds_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

# 1. The dumps: of the replay for the pictures check (eq) and of the replay for the cost (cost).
function(dump_set tag replay result_var)
  set(args ${common} --input-script "${replay}")
  if(DEFINED EQ_FRAMES AND tag STREQUAL "eq")
    list(APPEND args --frames ${EQ_FRAMES})
  endif()
  execute_process(COMMAND ${args} --dump-assets "${OUT}/${tag}_gfx" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0 OR NOT EXISTS "${OUT}/${tag}_gfx/manifest.json")
    message(FATAL_ERROR "--dump-assets failed (${rc}): ${out}${err}")
  endif()
  set(packs --asset-pack "${OUT}/${tag}_gfx")
  if(NOT GAME STREQUAL "st")
    execute_process(COMMAND ${args} --dump-audio "${OUT}/${tag}_snd" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0 OR NOT EXISTS "${OUT}/${tag}_snd/manifest.json")
      message(FATAL_ERROR "--dump-audio failed (${rc}): ${out}${err}")
    endif()
    list(APPEND packs --asset-pack "${OUT}/${tag}_snd")
  endif()
  set(${result_var} ${packs} PARENT_SCOPE)
endfunction()
dump_set(eq "${EQ_REPLAY}" eq_packs)
dump_set(cost "${REPLAY}" packs)

# 2. The pictures.
set(eq_base ${common} --input-script "${EQ_REPLAY}")
if(DEFINED EQ_FRAMES)
  list(APPEND eq_base --frames ${EQ_FRAMES})
endif()
function(run_eq out_var)
  execute_process(COMMAND ${eq_base} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "x2recomp ${ARGN} exited with ${rc}: ${err}")
  endif()
  set(${out_var} "${out}" PARENT_SCOPE)
endfunction()
if(GAME STREQUAL "st")
  run_eq(out ${eq_packs} --modern upgrade,scale=2 --modern-check)
  if(NOT out MATCHES "screens check: [^;]*;[^;]*; ([0-9]+) differ with a palette[^;]*, ([0-9]+) differ otherwise" OR NOT CMAKE_MATCH_2 EQUAL 0)
    message(FATAL_ERROR "the ST dump as a pack differs from the frames: ${out}")
  endif()
  message("ST: both dumps together reproduce the frames")
else()
  if(NOT DEFINED EQ_FROM)
    set(EQ_FROM 0)
  endif()
  if(NOT DEFINED EQ_TO)
    set(EQ_TO 99999)
  endif()
  run_eq(plain --modern interp,scale=2 --modern-out ${EQ_FROM}-${EQ_TO}:-)
  run_eq(packed ${eq_packs} --modern interp,scale=2 --modern-out ${EQ_FROM}-${EQ_TO}:-)
  run_eq(again ${eq_packs} --modern interp,scale=2 --modern-out ${EQ_FROM}-${EQ_TO}:-)
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" a "${plain}")
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" b "${packed}")
  string(REGEX MATCHALL "presenthash [0-9]+ [0-9]+ [0-9a-f]+" c "${again}")
  list(LENGTH a n)
  if(n LESS 250)
    message(FATAL_ERROR "only ${n} presented pictures")
  endif()
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "the graphics dump and the audio dump together change the pictures of the run (frames ${EQ_FROM}-${EQ_TO})")
  endif()
  if(NOT b STREQUAL c)
    message(FATAL_ERROR "two runs with the same packs give different pictures")
  endif()
  message("${GAME}: ${n} pictures identical with both dumps loaded; repeatable")
  set(plain_args --modern interp,scale=3 --modern-out 0-99999:-)
endif()

# 3. The cost. (Atari ST: its screens and panel are composed only when a picture is presented, and a headless run presents none, so there is no
# run to time; the equality above is its check.)
if(GAME STREQUAL "st")
  message("ST: no headless presenter loop to time; the cost gate does not apply")
  cmake_language(EXIT 0)
endif()
set(best_plain 1e9)
set(best_pack 1e9)
foreach(i RANGE 1 ${RUNS})
  timed(t_plain ${plain_args})
  timed(t_pack ${packs} ${plain_args})
  if(t_plain LESS best_plain)
    set(best_plain ${t_plain})
  endif()
  if(t_pack LESS best_pack)
    set(best_pack ${t_pack})
  endif()
endforeach()
# overhead = (pack - plain) / plain, in cmake's integer arithmetic on microseconds
function(micros var seconds)
  if(seconds MATCHES "^([0-9]+)\\.?([0-9]*)$")
    set(whole "${CMAKE_MATCH_1}")
    set(frac "${CMAKE_MATCH_2}000000")
    string(SUBSTRING "${frac}" 0 6 frac)
    math(EXPR us "${whole} * 1000000 + ${frac}")
    set(${var} ${us} PARENT_SCOPE)
  else()
    set(${var} 0 PARENT_SCOPE)
  endif()
endfunction()
micros(us_plain "${best_plain}")
micros(us_pack "${best_pack}")
if(us_plain EQUAL 0)
  message(FATAL_ERROR "could not read the plain run's time (${best_plain})")
endif()
math(EXPR over_permille "(${us_pack} - ${us_plain}) * 1000 / ${us_plain}")
string(REGEX MATCH "^([0-9]+)\\.?([0-9]*)$" _m "${MAX_OVERHEAD}")
set(frac "${CMAKE_MATCH_2}000")
string(SUBSTRING "${frac}" 0 3 frac)
math(EXPR limit_permille "${CMAKE_MATCH_1} * 1000 + ${frac}")
message("${GAME}: best of ${RUNS}: ${best_plain} s without packs, ${best_pack} s with both dumps: overhead ${over_permille} per mille (limit ${limit_permille})")
if(over_permille GREATER limit_permille)
  message(FATAL_ERROR "the packs cost ${over_permille} per mille more than the run without (limit ${limit_permille})")
endif()
